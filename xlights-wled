#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="${SCRIPT_DIR}/build/libs/xlights-wled-integration.jar"

if [[ ! -f "$JAR" ]]; then
  echo "ERROR: JAR not found at $JAR — run './gradlew bootJar' first" >&2
  exit 1
fi

exec java \
  -Xmx512m \
  -Xms128m \
  ${JAVA_OPTS:-} \
  -jar "$JAR" "$@"
